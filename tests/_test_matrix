#!/usr/bin/env bash
# __VERSION__="1.0.20260913130000Z"
# Differential test suite: compares datetime against the installed GNU date
# for every option and for a matrix of option combinations.  Options that
# GNU date does not have (legacy formats) are checked for output shape and
# internal consistency instead (short name == long name, with/without -u).
#
# Usage: ./tests/_test_matrix [--details]
#   --details  print one line per case showing the parameters and the
#              result: "OK" in green, "FAILED" in red.  Without --details
#              only failed cases are printed.
#
# Exit code: 0 if all cases pass, 1 otherwise.
set -uo pipefail
export LC_ALL=C

REPO_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
export REPO_DIR
BIN="$REPO_DIR/datetime"
export BIN
TMPDIR=$(mktemp -d)
trap 'rm -rf "$TMPDIR"' EXIT
mkdir -p "$TMPDIR/sub"
printf 'x\n' > "$TMPDIR/ref"
touch -t 202001020304 "$TMPDIR/ref"

# ---------------------------------------------------------------- reporting
DETAILS=0
for arg in "$@"; do
  case $arg in
    --details) DETAILS=1 ;;
    *)
      echo "usage: $0 [--details]" >&2
      exit 2
      ;;
  esac
done

if [[ $DETAILS -eq 1 && ( -t 1 || -t 2 || -n "${FORCE_COLOR:-}" ) ]]; then
  GREEN=$'\033[32m'
  RED=$'\033[31m'
  RESET=$'\033[0m'
else
  GREEN=""
  RED=""
  RESET=""
fi
ok_label() { printf '%sOK%s' "$GREEN" "$RESET"; }
failed_label() { printf '%sFAILED%s' "$RED" "$RESET"; }

PASS=0
FAIL=0
TOTAL=0
declare -a FAILED_CASES=()

print_case_line() {
  # print_case_line <label> <params> <ours> <theirs> <status_label>
  printf '%-24s %-42s -> ours: %-30s date: %-26s %s\n' \
    "$1" "$2" "$3" "$4" "$5"
}

# report <rc:0=pass|1=fail> <label> <params> <ours> <theirs>
report() {
  local cmp_rc="$1" label="$2" params="$3" ours="$4" theirs="$5"
  TOTAL=$((TOTAL + 1))
  if [[ -z "$params" ]]; then
    params="(no options)"
  fi
  if [[ "$cmp_rc" -eq 0 ]]; then
    PASS=$((PASS + 1))
    if [[ $DETAILS -eq 1 ]]; then
      print_case_line "$label" "$params" "${ours:0:30}" "${theirs:0:26}" \
        "$(ok_label)"
    fi
  else
    FAIL=$((FAIL + 1))
    FAILED_CASES+=("$label: $params")
    # Failures always print, with --details requested or not.
    print_case_line "$label" "$params" "${ours:0:30}" "${theirs:0:26}" \
      "$(failed_label)"
  fi
}

# compare <label> <params> -- <args for both datetime and date ...>
# Runs both utilities with identical arguments and compares stdout and
# exit code.  Both failing counts as compatible (both reject the input).
compare() {
  local label="$1" params="$2"
  shift 2
  local ours_out ours_rc date_out date_rc
  ours_out=$("$BIN" "$@" 2>/dev/null)
  ours_rc=$?
  date_out=$(date "$@" 2>/dev/null)
  date_rc=$?
  if [[ "$ours_rc" -eq "$date_rc" && "$ours_out" == "$date_out" ]]; then
    report 0 "$label" "$params" "$ours_out" "$date_out"
  else
    report 1 "$label" "$params" \
      "rc=$ours_rc [$ours_out]" "rc=$date_rc [$date_out]"
  fi
}

# compare_formats <label> <params> <format> -- <leading args ...>
# Same as compare but for cases where both sides need an explicit +FORMAT
# that must not be expanded by this script.
compare_formats() {
  local label="$1" params="$2" fmt="$3"
  shift 3
  compare "$label" "$params" "$@" "$fmt"
}

# compare_tol <label> <params> <tolerance_seconds> -- <args...>
# For inherently time-varying numeric (+%s) outputs: both must succeed and
# agree within TOL seconds (the two processes run back to back).
compare_tol() {
  local label="$1" params="$2" tol="$3"
  shift 3
  local ours_out ours_rc date_out date_rc
  ours_out=$("$BIN" "$@" 2>/dev/null)
  ours_rc=$?
  date_out=$(date "$@" 2>/dev/null)
  date_rc=$?
  if [[ $ours_rc -eq 0 && $date_rc -eq 0 \
      && "$ours_out" =~ ^-?[0-9]+$ && "$date_out" =~ ^-?[0-9]+$ \
      && $((ours_out - date_out)) -le $tol && $((date_out - ours_out)) -le $tol ]]; then
    report 0 "$label" "$params" "$ours_out" "$date_out"
  else
    report 1 "$label" "$params" \
      "rc=$ours_rc [$ours_out]" "rc=$date_rc [$date_out]"
  fi
}

# compare_norm <label> <params> -- <args...>
# Like compare but normalizes the ISO decimal separator before comparing:
# GNU date emits a comma in ns ISO output ("…,935167613+02:00"), ours
# always emits a dot (documented deviation).
compare_norm ()
{
  local label="$1" params="$2"
  shift 2
  local ours_out ours_rc date_out date_rc on dn
  ours_out=$("$BIN" "$@" 2>/dev/null)
  ours_rc=$?
  date_out=$(date "$@" 2>/dev/null)
  date_rc=$?
  on="${ours_out//,/.}"
  dn="${date_out//,/.}"
  if [[ $ours_rc -eq $date_rc && "$on" == "$dn" ]]; then
    report 0 "$label" "$params" "$ours_out" "$date_out"
  else
    report 1 "$label" "$params" \
      "rc=$ours_rc [$ours_out]" "rc=$date_rc [$date_out]"
  fi
}

# compare_ns <label> <params> -- <args...>
# For ns-resolution outputs of the *current* time: the digits race the
# clock between the two invocations.  Require identical shape, the same
# whole second and separator-normalized output; retry a few times so a
# second boundary between the two runs does not flake.
compare_ns ()
{
  local label="$1" params="$2"
  shift 2
  local attempt ours_out ours_rc date_out date_rc ots ofr dts dfr
  for attempt in 1 2 3; do
    ours_out=$("$BIN" "$@" 2>/dev/null)
    ours_rc=$?
    date_out=$(date "$@" 2>/dev/null)
    date_rc=$?
    # GNU emits a comma as ISO decimal separator for -Ins; normalize so
    # the fraction split below works for both separators.
    ours_out="${ours_out//,/.}"
    date_out="${date_out//,/.}"
    ots="${ours_out%%.*}" ; ofr="${ours_out#*.}"
    dts="${date_out%%.*}" ; dfr="${date_out#*.}"
    if [[ $ours_rc -eq 0 && $date_rc -eq 0 \
        && "$ofr" != "$ours_out" && "$dfr" != "$date_out" \
        && "$ofr" =~ ^[0-9]{6,} && "$dfr" =~ ^[0-9]{6,} \
        && "${ots//,/.}" == "${dts//,/.}" ]]; then
      report 0 "$label" "$params" "$ours_out" "$date_out"
      return
    fi
  done
  report 1 "$label" "$params" \
    "rc=$ours_rc [$ours_out]" "rc=$date_rc [$date_out]"
}

# ours_matches <label> <params> <pattern> -- <datetime args...>
# For options without a GNU date counterpart: check exit status and that
# the output matches an extended regexp.
ours_matches() {
  local label="$1" params="$2" pattern="$3"
  shift 3
  local out rc
  out=$("$BIN" "$@" 2>/dev/null)
  rc=$?
  if [[ $rc -eq 0 && "$out" =~ $pattern ]]; then
    report 0 "$label" "$params" "$out" "(shape)"
  else
    report 1 "$label" "$params" \
      "rc=$rc [$out]" "pattern: $pattern"
  fi
}

# stderr_contains <label> <params> <substring> -- <datetime args...>
stderr_contains() {
  local label="$1" params="$2" substr="$3"
  shift 3
  [[ "$1" == "--" ]] && shift
  local err
  err=$("$BIN" "$@" 2>&1 1>/dev/null)
  if [[ "$err" == *"$substr"* ]]; then
    report 0 "$label" "$params" "(stderr)" "(stderr)"
  else
    report 1 "$label" "$params" "(stderr)" "expected: $substr"
  fi
}

# ---------------------------------------------------------------- suite
echo "=== datetime differential matrix vs GNU date ==="
echo "BIN=$BIN"
date --version | head -1
if [[ $DETAILS -eq 1 ]]; then
  echo "-- details: one line per case; OK=green, FAILED=red --"
fi

# ------------------------------------------------- 1. default output
# Inherently time-varying: check shape only.
out=$("$BIN" 2>/dev/null)
if [[ "$out" =~ ^[0-9]{14}$ ]]; then
  report 0 "default" "" "$out" "YYYYMMDDhhmmss"
else
  report 1 "default" "" "$out" "YYYYMMDDhhmmss"
fi

# ------------------------------------------------- 2. every option vs date
compare "-u == --utc" "-u" -u '+%F %H:%M'
compare "--universal alias" "--universal" --universal '+%F %H:%M'
compare "-R" "-R" -R
compare "--rfc-email alias" "--rfc-email" --rfc-email
compare "--rfc-3339=date" "--rfc-3339=date" --rfc-3339=date
compare "--rfc-3339=seconds" "--rfc-3339=seconds" --rfc-3339=seconds
compare_ns "--rfc-3339=ns (now)" "--rfc-3339=ns" --rfc-3339=ns
compare "--rfc-3339 invalid" "--rfc-3339=bogus" --rfc-3339=bogus
compare "-I default" "-I" -I
compare "-I date" "-I date" -Idate
compare "-I hours" "-I hours" -Ihours
compare "-I minutes" "-I minutes" -Iminutes
compare "-I seconds" "-I seconds" -Iseconds
compare_ns "-I ns (now)" "-I ns" -Ins
compare "-I invalid" "-I bogus" -I bogus
# GNU date rejects "-I=seconds"; we accept the '=' spelling (documented
# lenience), so this is checked as a shape, not differentially.
ours_matches "-I=seconds (ours)" "-I=seconds" \
  '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}' -I=seconds
compare "--resolution" "--resolution" --resolution
compare "-d epoch" "-d @1234567890" -d @1234567890 '+%F %T'
compare "-d epoch raw" "-d @1234567890" -d @1234567890 '+%s'
compare "-d frac epoch" "-d @1234567890.5" -d @1234567890.5 '+%s.%N'
compare "-d neg epoch" "-d @-1" -d @-1 '+%s'
compare "-d neg frac" "-d @-0.5" -d @-0.5 '+%s.%N'
compare "-d ISO T" "-d 2020-01-02T03:04:05" -d 2020-01-02T03:04:05 '+%s'
compare "-d ISO space" "-d '2020-01-02 03:04:05'" -d '2020-01-02 03:04:05' '+%s'
compare "-d ISO +zone" "-d '2020-01-02T03:04:05+02:00'" -d '2020-01-02T03:04:05+02:00' '+%s'
compare "-d ISO space zone" "-d '2020-01-02 03:04:05 +0100'" -d '2020-01-02 03:04:05 +0100' '+%s'
compare "-d dashes date" "-d 2020-01-02" -d 2020-01-02 '+%s'
compare "-d dashes min" "-d '2020-01-02 03:04'" -d '2020-01-02 03:04' '+%s'
compare "-d slashes" "-d 2020/01/02" -d 2020/01/02 '+%s'
compare "-d slashes time" "-d '2020/01/02 03:04:05'" -d '2020/01/02 03:04:05' '+%s'
compare "-d US 2digit" "-d 01/02/20" -d 01/02/20 '+%s'
compare "-d US 4digit" "-d 01/02/2020" -d 01/02/2020 '+%s'
compare "-d US time" "-d '01/02/20 03:04:05'" -d '01/02/20 03:04:05' '+%s'
ours_matches "-d compact14 (ours)" "-d 20200102030405" '^[0-9]+$' \
  -d 20200102030405 '+%s'
compare "-d compact8" "-d 20200102" -d 20200102 '+%s'
compare "-d ctime-like" "-d 'Wed Jan  2 03:04:05 2020'" -d 'Wed Jan  2 03:04:05 2020' '+%s'
compare "-d RFC 5322 numzone" "-d 'Wed, 01 Oct 2020 09:00:00 +0200'" -d 'Wed, 01 Oct 2020 09:00:00 +0200' '+%s'
compare "-d RFC 5322 namezone" "-d 'Wed, 01 Oct 2020 09:00:00 UTC'" -d 'Wed, 01 Oct 2020 09:00:00 UTC' '+%s'
compare "-d dMonY time" "-d '01 Oct 2020 09:00:00'" -d '01 Oct 2020 09:00:00' '+%s'
compare "-d time-only" "-d 09:00" -d 09:00 '+%F %H:%M'
compare "-d time-only sec" "-d 09:00:30" -d 09:00:30 '+%F %T'
compare_tol "-d '1 hour ago' +%s" "-d '1 hour ago'" 2 -d '1 hour ago' '+%s'
compare "-d next fri" "-d 'next fri'" -d 'next fri' '+%F'
compare "-d today" "-d today" -d today '+%F'
compare "-d tomorrow" "-d tomorrow" -d tomorrow '+%F'
compare "-d yesterday" "-d yesterday" -d yesterday '+%F'
compare_tol "-d now +%s" "-d now" 2 -d now '+%s'
compare "-d TZ quoted" "-d 'TZ=...'" -d 'TZ="UTC" 2020-01-02 03:04:05' '+%s'
# GNU date rejects an unquoted TZ= prefix; we accept it (documented
# lenience), so check the exact expected epoch instead of a diff.
ours_matches "-d TZ bare (ours)" "-d 'TZ=UTC ...'" '^1577934245$' \
  -d 'TZ=UTC 2020-01-02 03:04:05' '+%s'
compare "-d TZ only" "-d 'TZ=\"UTC\"'" -d 'TZ="UTC"' '+%z'
# An empty date string means "now" (GNU parity).  Default layouts differ
# (ours: YYYYMMDDhhmmss), so compare the default shape and +%s with slack.
ours_matches "-d empty (ours)" "-d ''" '^[0-9]{14}$' -d ""
compare_tol "-d empty +%s" "-d '' +%s" 2 -d "" '+%s'
compare "-d invalid" "-d not-a-date" -d not-a-date
compare "-d @-0.5 raw" "-d @-0.5" -d @-0.5 '+%s.%N'
compare "-r mtime" "-r FILE" -r "$TMPDIR/ref" '+%s'
compare "-r mtime ns" "-r FILE ns" -r "$TMPDIR/ref" '+%s.%N'
compare "-r missing" "-r /no/such/file" -r /no/such/file
compare "-u -d epoch" "-u -d @0" -u -d @0 '+%F %T'
compare "-u %Z" "-u +%Z" -u '+%Z'
compare "-u %z" "-u +%z" -u '+%z'
# --debug: same exit code and a parse trace on stderr for both; stdout
# layout intentionally differs (ours prints its own default format).
dbg_ours=$("$BIN" --debug -d @0 2>"$TMPDIR/dbg_ours")
dbg_ours_rc=$?
dbg_date=$(date --debug -d @0 2>"$TMPDIR/dbg_date")
dbg_date_rc=$?
if [[ $dbg_ours_rc -eq $dbg_date_rc && -s "$TMPDIR/dbg_ours" \
    && -s "$TMPDIR/dbg_date" ]]; then
  report 0 "--debug exit+trace" "--debug" \
    "rc=$dbg_ours_rc, trace on stderr" "rc=$dbg_date_rc, trace on stderr"
else
  report 1 "--debug exit+trace" "--debug" \
    "rc=$dbg_ours_rc, stderr: $(head -c 40 "$TMPDIR/dbg_ours" 2>/dev/null)" \
    "rc=$dbg_date_rc, stderr: $(head -c 40 "$TMPDIR/dbg_date" 2>/dev/null)"
fi

# --set: date(1) fails without root; ours warns and exits 0 (documented).
stderr_contains "-s without root warns" "-s ..." 'cannot set date' \
  -- -s '2020-01-02 03:04:05'
stderr_contains "--set= without root warns" "--set=..." 'cannot set date' \
  -- --set='2020-01-02'
stderr_contains "-s invalid date fails" "-s not-a-date" 'invalid date' \
  -- -s not-a-date

# ------------------------------------------------- 3. every format (vs date)
FMT=(
  '%%' '%a' '%A' '%b' '%B' '%c' '%C' '%d' '%D' '%e' '%F' '%g' '%G' '%h'
  '%H' '%I' '%j' '%k' '%l' '%m' '%M' '%n' '%N' '%p' '%P' '%q' '%r' '%R'
  '%s' '%S' '%t' '%T' '%u' '%U' '%V' '%w' '%W' '%x' '%X' '%y' '%Y'
  '%z' '%:z' '%::z' '%:::z' '%Z'
  '%-d' '%_d' '%0e' '%5d' '%+4Y' '%+5Y' '%+6Y' '%-H' '%_H'
  '%Ec' '%EC' '%Ex' '%EX' '%Ey' '%EY' '%Od' '%Om' '%Oy' '%OH' '%OM'
)
i=0
for f in "${FMT[@]}"; do
  i=$((i + 1))
  compare_formats "fmt[$i]" "$f" "$f" -d @0
done

# ------------------------------------------------- 4. legacy options
legacy_shape() {
  case $1 in
    -hr | --human-readable) echo '^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}$' ;;
    -c | --compact | iso-basic) echo '^[0-9]{8}T[0-9]{6}$' ;;
    -cd | --calendar-date) echo '^[0-9]{4}-[0-9]{2}-[0-9]{2}$' ;;
    -cdb | --calendar-date-base) echo '^[0-9]{8}$' ;;
    -od | --ordinal-date) echo '^[0-9]{4}-[0-9]{3}$' ;;
    -odb | --ordinal-date-base) echo '^[0-9]{7}$' ;;
    -wd | --week-date) echo '^[0-9]{4}-W[0-9]{2}-[1-7]$' ;;
    -wdb | --week-date-basic) echo '^[0-9]{4}W[0-9]{2}[1-7]$' ;;
    --timestamp) echo '^[0-9]{14}Z$' ;;
  esac
}
for opt in -hr --human-readable -c --compact iso-basic -cd --calendar-date \
  -cdb --calendar-date-base -od --ordinal-date -odb --ordinal-date-base \
  -wd --week-date -wdb --week-date-basic --timestamp; do
  ours_matches "legacy $opt" "$opt" "$(legacy_shape "$opt")" "$opt"
done
# Legacy short/long pairs must agree exactly (UTC-stable via +%s? no: the
# formats have no seconds-resolution ambiguity, but the clock may tick;
# compare normalized outputs taken back-to-back is flaky, so compare the
# pair rendered twice from the same option set shape: use -d @0 anchors).
for pair in '-hr:--human-readable' '-c:--compact' '-c:iso-basic' \
  '-cd:--calendar-date' '-cdb:--calendar-date-base' \
  '-od:--ordinal-date' '-odb:--ordinal-date-base' \
  '-wd:--week-date' '-wdb:--week-date-basic'; do
  a=${pair%%:*}
  b=${pair##*:}
  ours_out=$("$BIN" -d @0 "$a" 2>/dev/null)
  ours_out2=$("$BIN" -d @0 "$b" 2>/dev/null)
  if [[ "$ours_out" == "$ours_out2" ]]; then
    report 0 "legacy pair $a==$b" "$a vs $b" "$ours_out" "$ours_out2"
  else
    report 1 "legacy pair $a==$b" "$a vs $b" "$ours_out" "$ours_out2"
  fi
done

# ------------------------------------------------- 5. errors
compare "unknown short opt" "-Z" -Z
compare "unknown long opt" "--bogus" --bogus
compare "mutual excl -d -f" "-d now -f X" -d now -f "$TMPDIR/ref"
compare "mutual excl -d -r" "-d now -r X" -d now -r "$TMPDIR/ref"
compare "mutual excl -d res" "-d now --resolution" -d now --resolution
compare "mutual excl -f -r" "-f X -r X" -f "$TMPDIR/ref" -r "$TMPDIR/ref"
compare "operand garbage" "garbage-arg" garbage-arg

# ------------------------------------------------- 6. combination matrix
echo ""
echo "=== combination matrix ==="

# 6a. date sources x formats (deterministic, single-token sources so the
# word splitting below passes them through verbatim)
SOURCES=("-d @1234567890" "-d 2020-01-02" "-r $TMPDIR/ref")
FORMATS=('+%F' '+%T' '+%s' '+%F %T %z' '+%j' '+%u' '+%V' '+%C%g%G' '+%I%p' '+%k%l' '+%D' '+%N' '+%q')
src=0
for s in "${SOURCES[@]}"; do
  src=$((src + 1))
  fno=0
  for f in "${FORMATS[@]}"; do
    fno=$((fno + 1))
    compare_formats "matrix[src$src]" "$s $f" "$f" $s
  done
done

# src4: GNU date *mis*parses 14-digit compact dates ("+2020010203-04-05");
# ours reads them as %Y%m%d%H%M%S (documented extension).  Check ours
# against the equivalent spaced form instead of against GNU.
src4a=$("$BIN" -d 20200102030405 '+%s' 2>/dev/null)
src4b=$("$BIN" -d '2020-01-02 03:04:05' '+%s' 2>/dev/null)
if [[ -n "$src4a" && "$src4a" == "$src4b" ]]; then
  report 0 "matrix[src4 compact==spaced]" "-d 20200102030405" "$src4a" "$src4b"
else
  report 1 "matrix[src4 compact==spaced]" "-d 20200102030405" "$src4a" "$src4b"
fi

# 6b. output styles x utc x debug
STYLES=("-R" "--rfc-3339=seconds" "--rfc-3339=ns" "-I" "-Iseconds" "-Ins")
for st in "${STYLES[@]}"; do
  for extra in "" "-u" "--debug" "-u --debug"; do
    # shellcheck disable=SC2086
    case $st in
      --rfc-3339=ns|-Ins)
        compare_norm "matrix[style]" "$st $extra" $st $extra -d @0
        ;;
      *)
        compare "matrix[style]" "$st $extra" $st $extra -d @0
        ;;
    esac
  done
done

# 6c. legacy options x -u (shape only, time-varying)
for opt in -hr -c -cd -cdb -od -odb -wd -wdb --timestamp; do
  for extra in "" "-u"; do
    # shellcheck disable=SC2086
    ours_matches "matrix[legacy]" "$opt $extra" "$(legacy_shape "$opt")" \
      $opt $extra
  done
done

# 6d. flags x format on a fixed date (padding/width interactions)
for flag in '-' '_' '0' '^' '#'; do
  compare_formats "matrix[flag]" "%${flag}d" "%${flag}d" -d @0
  compare_formats "matrix[flag]" "%${flag}H" "%${flag}H" -d @0
done
for width in 1 3 5 10; do
  compare_formats "matrix[width]" "%${width}d" "%${width}d" -d @0
  compare_formats "matrix[width]" "%${width}Y" "%${width}Y" -d @0
done

# 6e. precedence cases (ours only; date has no legacy formats)
ours_matches "matrix[last +FORMAT wins]" "+%Y +%s" '^0$' -d @0 '+%Y' '+%s'
ours_out=$("$BIN" -d @0 -hr '+%s' 2>/dev/null)
if [[ "$ours_out" =~ ^[0-9]+$ ]]; then
  report 0 "matrix[format beats legacy]" "-hr +%s" "$ours_out" "(precedence)"
else
  report 1 "matrix[format beats legacy]" "-hr +%s" "$ours_out" "(precedence)"
fi

# ------------------------------------------------- summary
echo ""
echo "=== Summary: $PASS passed, $FAIL failed, $TOTAL total ==="
if [[ $FAIL -gt 0 ]]; then
  echo "failed cases:"
  for c in "${FAILED_CASES[@]}"; do
    echo "  $c"
  done
  exit 1
fi
exit 0
