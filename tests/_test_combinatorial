#!/usr/bin/env bash
# __VERSION__="1.0.20260909104000Z"
set -uo pipefail
REPO_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
export REPO_DIR
BIN="$REPO_DIR/datetime"
export BIN
TMPDIR=$(mktemp -d)
export TMPDIR
trap 'rm -rf "$TMPDIR"' EXIT

PASS=0
FAIL=0
TOTAL=0

check() {
  local desc="$1"; shift
  TOTAL=$((TOTAL+1))
  if "$@"; then
    echo "PASS: $desc"
    PASS=$((PASS+1))
  else
    echo "FAIL: $desc"
    FAIL=$((FAIL+1))
  fi
}
assert_eq() {
  local got="$1" expect="$2" desc="$3"
  TOTAL=$((TOTAL+1))
  if [[ "$got" == "$expect" ]]; then echo "PASS: $desc"; PASS=$((PASS+1)); else echo "FAIL: $desc"; echo "  expected: '$expect'"; echo "  got: '$got'"; FAIL=$((FAIL+1)); fi
}
assert_match() {
  local got="$1" pat="$2" desc="$3"
  TOTAL=$((TOTAL+1))
  if [[ "$got" =~ $pat ]]; then echo "PASS: $desc"; PASS=$((PASS+1)); else echo "FAIL: $desc"; echo "  pattern: $pat"; echo "  got: '$got'"; FAIL=$((FAIL+1)); fi
}
assert_fail() {
  local desc="$1"; shift
  TOTAL=$((TOTAL+1))
  if ! "$@" >/dev/null 2>&1; then echo "PASS: $desc (correctly failed)"; PASS=$((PASS+1)); else echo "FAIL: $desc (should have failed)"; FAIL=$((FAIL+1)); fi
}
assert_success() {
  local desc="$1"; shift
  TOTAL=$((TOTAL+1))
  if "$@" >/dev/null 2>&1; then echo "PASS: $desc"; PASS=$((PASS+1)); else echo "FAIL: $desc"; FAIL=$((FAIL+1)); fi
}

echo "=== combinatorial exhaustive tests ==="
"$BIN" --help >/dev/null 2>&1 || { echo "binary not executable"; exit 1; }

# Prepare fixtures
printf "2020-01-02\n2020-01-03\n" > "$TMPDIR/dates.txt"
touch -d '2020-01-02 03:04:05' "$TMPDIR/ref"
printf "2020-01-02T03:04:05\n" > "$TMPDIR/dates2.txt"
echo "hello" > "$TMPDIR/empty"

# ---- 1. Singleton legacy exhaustive ----
for opt in "-hr" "--human-readable" "-c" "--compact" "iso-basic" "-cd" "--calendar-date" "-cdb" "--calendar-date-base" "-od" "--ordinal-date" "-odb" "--ordinal-date-base" "-wd" "--week-date" "-wdb" "--week-date-basic" "--timestamp"; do
  # iso-basic without dash is handled as legacy
  check "legacy singleton $opt" bash -c "\"\$BIN\" $opt >/dev/null"
done

# ---- 2. GNU singleton output formats ----
# ISO variants via short -I and long --iso-8601
for fmt in date hours minutes seconds ns; do
  check "iso-8601=$fmt via --iso-8601=$fmt" bash -c "\"\$BIN\" --iso-8601=$fmt >/dev/null"
  check "iso-8601=$fmt via suffix -I$fmt" bash -c "\"\$BIN\" -I$fmt >/dev/null"
done
check "iso-8601 bare -I" bash -c '"$BIN" -I >/dev/null'
check "iso-8601 bare --iso-8601" bash -c '"$BIN" --iso-8601 >/dev/null'

for fmt in date seconds ns; do
  check "rfc-3339=$fmt via --rfc-3339=$fmt" bash -c "\"\$BIN\" --rfc-3339=$fmt >/dev/null"
  check "rfc-3339=$fmt via --rfc-3339 $fmt" bash -c "\"\$BIN\" --rfc-3339 $fmt >/dev/null"
done

check "rfc-email -R" bash -c '"$BIN" -R >/dev/null'
check "rfc-email --rfc-email" bash -c '"$BIN" --rfc-email >/dev/null'
check "resolution --resolution" bash -c '"$BIN" --resolution >/dev/null'
check "help --help" bash -c '"$BIN" --help >/dev/null'
check "help -h" bash -c '"$BIN" -h >/dev/null'
check "version --version" bash -c '"$BIN" --version >/dev/null'
check "version -V" bash -c '"$BIN" -V >/dev/null'

# ---- 3. Alias equivalence ----
alias_eq() {
  local a="$1" b="$2" desc="$3"
  TOTAL=$((TOTAL+1))
  out1=$($BIN $a +"%Y-%m-%d" 2>/dev/null)
  out2=$($BIN $b +"%Y-%m-%d" 2>/dev/null)
  # For -u family, test with +"%Z"
  if [[ "$a" == *"%Z"* || "$b" == *"%Z"* ]]; then
    out1=$($BIN $a +"%Z" 2>/dev/null)
    out2=$($BIN $b +"%Z" 2>/dev/null)
  fi
  if [[ "$out1" == "$out2" ]]; then echo "PASS: alias $desc"; PASS=$((PASS+1)); else echo "FAIL: alias $desc"; echo "  $a => $out1"; echo "  $b => $out2"; FAIL=$((FAIL+1)); fi
}
alias_eq "-u" "--utc" " -u == --utc"
alias_eq "-u" "--universal" " -u == --universal"
alias_eq "--utc" "--universal" " --utc == --universal"
alias_eq "-R" "--rfc-email" " -R == --rfc-email"
alias_eq "-d @0" "--date=@0" " -d @0 == --date=@0"
alias_eq "-f $TMPDIR/dates.txt" "--file=$TMPDIR/dates.txt" " -f == --file="
alias_eq "-r $TMPDIR/ref" "--reference=$TMPDIR/ref" " -r == --reference="
alias_eq "-s 2020-01-02" "--set=2020-01-02" " -s == --set="
alias_eq "-I" "--iso-8601" " -I == --iso-8601"
alias_eq "-Iseconds" "--iso-8601=seconds" " -Iseconds == --iso-8601=seconds"

# ---- 4. Date sources singleton ----
check "date @0 -d" bash -c '"$BIN" -d "@0" >/dev/null'
check "date @0 --date" bash -c '"$BIN" --date="@0" >/dev/null'
check "date string 2020-01-02" bash -c '"$BIN" -d "2020-01-02" >/dev/null'
check "date now" bash -c '"$BIN" -d "now" >/dev/null'
check "date today" bash -c '"$BIN" -d "today" >/dev/null'
check "date yesterday" bash -c '"$BIN" -d "yesterday" >/dev/null'
check "date tomorrow" bash -c '"$BIN" -d "tomorrow" >/dev/null'
check "date TZ prefix" bash -c '"$BIN" -d "TZ=\"UTC\" 2020-01-02" >/dev/null'
check "date fractional epoch" bash -c '"$BIN" -d "@1234567890.123456789" >/dev/null'
check "file -f" bash -c '"$BIN" -f "$TMPDIR/dates.txt" >/dev/null'
check "file --file=" bash -c '"$BIN" --file="$TMPDIR/dates.txt" >/dev/null'
check "file stdin -" bash -c 'printf "2020-01-02\n" | "$BIN" -f - >/dev/null'
check "reference -r" bash -c '"$BIN" -r "$TMPDIR/ref" >/dev/null'
check "reference --reference=" bash -c '"$BIN" --reference="$TMPDIR/ref" >/dev/null'
check "set -s" bash -c '"$BIN" -s "2020-01-02" >/dev/null 2>&1; test $? -eq 0'
check "set --set=" bash -c '"$BIN" --set="2020-01-02" >/dev/null 2>&1; test $? -eq 0'
check "MMDDhhmm positional" bash -c '"$BIN" 01010000 >/dev/null 2>&1; test $? -eq 0'

# ---- 5. Mutually exclusive matrix (all pairs + triples should fail) ----
for a in "-d now" "-f $TMPDIR/dates.txt" "-r $TMPDIR/ref" "--resolution"; do
  for b in "-d now" "-f $TMPDIR/dates.txt" "-r $TMPDIR/ref" "--resolution"; do
    [[ "$a" == "$b" ]] && continue
    # only test each unordered pair once to avoid duplicate
    if [[ "$a" > "$b" ]]; then continue; fi
    check "mutual exclusive pair: $a + $b should fail" bash -c "\"\$BIN\" $a $b >/dev/null 2>&1; test \$? -ne 0"
  done
done
# triples
check "mutual exclusive triple -d -f -r" bash -c '"$BIN" -d now -f "$TMPDIR/dates.txt" -r "$TMPDIR/ref" >/dev/null 2>&1; test $? -ne 0'
check "mutual exclusive triple -d --resolution -r" bash -c '"$BIN" -d now --resolution -r "$TMPDIR/ref" >/dev/null 2>&1; test $? -ne 0'

# ---- 6. Compatible pairwise matrix (should succeed) ----
# -u with each date source and format
for base in "-d @0" "-f $TMPDIR/dates.txt" "-r $TMPDIR/ref" "--resolution" "-I" "-R" "--rfc-3339=seconds"; do
  check "compatible -u + $base" bash -c "\"\$BIN\" -u $base >/dev/null 2>&1"
done
for base in "-d @0" "-f $TMPDIR/dates.txt" "-r $TMPDIR/ref"; do
  check "compatible --debug + $base" bash -c "\"\$BIN\" --debug $base >/dev/null 2>&1"
done
# +FORMAT with each date source
for src in "" "-d @0" "-d 2020-01-02" "-r $TMPDIR/ref"; do
  check "compatible src '$src' +FORMAT %F" bash -c "\"\$BIN\" $src +\"%F\" >/dev/null"
  check "compatible src '$src' +FORMAT %T" bash -c "\"\$BIN\" $src +\"%T\" >/dev/null"
done
# Legacy vs GNU format last-wins: test that combinations don't crash and produce output
for combo in "-c -I" "-I -c" "-R --iso-8601=seconds" "--iso-8601=seconds -R" "-c --rfc-3339=seconds" "--rfc-3339=seconds -c"; do
  check "format combo $combo does not crash" bash -c "\"\$BIN\" $combo >/dev/null"
done

# ---- 7. FORMAT sequences exhaustive ----
SEQS=("%" "%a" "%A" "%b" "%B" "%c" "%C" "%d" "%D" "%e" "%F" "%g" "%G" "%h" "%H" "%I" "%j" "%k" "%l" "%m" "%M" "%n" "%N" "%p" "%P" "%q" "%r" "%R" "%s" "%S" "%t" "%T" "%u" "%U" "%V" "%w" "%W" "%x" "%X" "%y" "%Y" "%z" "%:z" "%::z" "%:::z" "%Z")
for s in "${SEQS[@]}"; do
  # escape % for bash
  check "FORMAT seq $s without -u" bash -c "\"\$BIN\" -d '@0' +\"$s\" >/dev/null"
  check "FORMAT seq $s with -u" bash -c "\"\$BIN\" -u -d '@0' +\"$s\" >/dev/null"
done
# Test %% special
assert_eq "$("$BIN" -d '@0' -u +"%")" "%" "FORMAT %% -> %"
assert_eq "$("$BIN" -d '@0' -u +"%Y%%m")" "1970%m" "FORMAT mixed %% -> literal % + m"

# ---- 8. FORMAT flags exhaustive ----
# Test each flag with numeric field %d (day) and %Y (year)
for flag in "-" "_" "0" "^" "#"; do
  check "FORMAT flag $flag with %d" bash -c "\"\$BIN\" -d '2020-01-02' +\"%${flag}d\" >/dev/null"
  check "FORMAT flag $flag with %A" bash -c "\"\$BIN\" -d '2020-01-02' +\"%${flag}A\" >/dev/null"
done
# plus flag '+' only for %Y
check "FORMAT flag + with %Y" bash -c '"$BIN" -d "2020-01-02" +"%+4Y" >/dev/null'
# width
for w in 1 2 5 10; do
  check "FORMAT width $w with %d" bash -c "\"\$BIN\" -d '2020-01-02' +\"%${w}d\" >/dev/null"
  check "FORMAT width $w with %Y" bash -c "\"\$BIN\" -d '2020-01-02' +\"%${w}Y\" >/dev/null"
done
# E/O modifiers
for mod in E O; do
  check "FORMAT modifier $mod with %c" bash -c "\"\$BIN\" -d '2020-01-02' +\"%${mod}c\" >/dev/null"
  check "FORMAT modifier $mod with %Y" bash -c "\"\$BIN\" -d '2020-01-02' +\"%${mod}Y\" >/dev/null"
done
# Combined flag+width
check "FORMAT combined %-5d" bash -c '"$BIN" -d "2020-01-02" +"%-5d" >/dev/null'
check "FORMAT combined %_10Y" bash -c '"$BIN" -d "2020-01-02" +"%_10Y" >/dev/null'
check "FORMAT combined %05d" bash -c '"$BIN" -d "2020-01-02" +"%05d" >/dev/null'
check "FORMAT combined %^_10A" bash -c '"$BIN" -d "2020-01-02" +"%^_10A" >/dev/null'

# ---- 9. +FORMAT with -u and -d matrix ----
for darg in "@0" "2020-01-02" "2020-01-02 03:04:05" "yesterday" "tomorrow" "TZ=\"UTC\" 2020-01-02"; do
  for u in "" "-u"; do
    check "FORMAT matrix d='$darg' u='$u' + %F" bash -c "\"\$BIN\" $u -d \"$darg\" +\"%F\" >/dev/null"
  done
done

# ---- 10. -f with -u and --debug matrix ----
for u in "" "-u"; do
  for dbg in "" "--debug"; do
    check "file matrix u='$u' dbg='$dbg'" bash -c "\"\$BIN\" $u $dbg -f \"$TMPDIR/dates.txt\" +\"%F\" >/dev/null"
  done
done

# ---- 11. Error cases exhaustive ----
# missing arg
for opt in "-d" "--date" "-f" "--file" "-r" "--reference" "-s" "--set" "--rfc-3339"; do
  check "error missing arg $opt" bash -c "\"\$BIN\" $opt >/dev/null 2>&1; test \$? -ne 0"
done
# invalid arg
check "error invalid --iso-8601" bash -c '"$BIN" --iso-8601=invalid >/dev/null 2>&1; test $? -ne 0'
check "error invalid --iso-8601 short" bash -c '"$BIN" -Iinvalid >/dev/null 2>&1; test $? -ne 0'
check "error invalid --rfc-3339" bash -c '"$BIN" --rfc-3339=invalid >/dev/null 2>&1; test $? -ne 0'
check "error invalid --rfc-3339 bare" bash -c '"$BIN" --rfc-3339 >/dev/null 2>&1; test $? -ne 0'
check "error invalid -d not-a-date" bash -c '"$BIN" -d "not-a-date" >/dev/null 2>&1; test $? -ne 0'
check "error invalid -f nonexistent" bash -c '"$BIN" -f /nonexistent >/dev/null 2>&1; test $? -ne 0'
check "error invalid -r nonexistent" bash -c '"$BIN" -r /nonexistent >/dev/null 2>&1; test $? -ne 0'
check "error unknown -Z" bash -c '"$BIN" -Z >/dev/null 2>&1; test $? -ne 0'
check "error unknown --unknown" bash -c '"$BIN" --unknown >/dev/null 2>&1; test $? -ne 0'
check "error unknown --foo-bar" bash -c '"$BIN" --foo-bar >/dev/null 2>&1; test $? -ne 0'

# ---- 12. Edge: long input, shell injection, overflow ----
printf "'%5000s\n" | tr ' ' 'A' > "$TMPDIR/long.txt"
check "edge long file not crash" bash -c '"$BIN" -f "$TMPDIR/long.txt" >/dev/null 2>&1; true'  # may fail but not crash
check "edge shell injection not executed" bash -c 'out=$("$BIN" -d '\''; touch /tmp/pwned123 ; echo '\'' 2>&1); test ! -f /tmp/pwned123'
longfmt=$(printf '%%%0.sY' {1..500})
check "edge long format not crash" bash -c "\"\$BIN\" -d '@0' -u +\"$longfmt\" >/dev/null 2>&1; true"
check "edge many specifiers 200" bash -c 'fmt=$(printf "%%Y%.0s" {1..200}); "$BIN" -d "@0" -u +"$fmt" >/dev/null'

# ---- 13. Help/version and ESC and idempotency ----
check "help no ESC" bash -c '! grep -q $'\''\x1b'\'' <("$BIN" --help)'
check "help contains Usage" bash -c '"$BIN" --help | grep -q "Usage:"'
check "help contains FORMAT controls" bash -c '"$BIN" --help | grep -q "FORMAT controls"'
check "help contains legacy" bash -c '"$BIN" --help | grep -q "Legacy output"'
check "version contains timezone" bash -c '"$BIN" --version | grep -q "Timezone:"'

# ---- 14. Binary symlink timestamp alias ----
check "timestamp alias via symlink" bash -c 'cp "$REPO_DIR/timestamp" "$TMPDIR/timestamp"; out=$("$TMPDIR/timestamp"); [[ $out =~ ^[0-9]{14}Z$ ]]'
check "timestamp alias --timestamp" bash -c '"$BIN" --timestamp | grep -q "Z$"'

# ---- 15. Triple combos with -u --debug + date source + format ----
for src in '-d @0' '-d "2020-01-02"' '-r "$TMPDIR/ref"'; do
  for iso in '' '-I' '--iso-8601=seconds' '-R' '--rfc-3339=seconds'; do
    check "triple -u --debug $src $iso" bash -c "\"\$BIN\" -u --debug $src $iso >/dev/null 2>&1"
  done
done

echo ""
echo "=== Summary: $PASS passed, $FAIL failed, $TOTAL total ==="
if [[ $FAIL -eq 0 ]]; then echo "All combinatorial tests passed."; exit 0; else echo "$FAIL test(s) failed."; exit 1; fi
